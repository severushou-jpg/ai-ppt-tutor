DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_TEXT_MODEL=qwen-plus
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
# 研究版参与者记录目录；留空时默认为 ~/Desktop/research_record。
STUDY_RECORD_ROOT=/Users/your-name/Desktop/research_record
# 可选：写入每次实验记录，便于锁定实际使用的代码版本。
STUDY_BUILD_COMMIT=local-study-build
# 用于签署可恢复处理阶段；请使用与 API Key 不同的高强度随机值。
CHECKPOINT_SIGNING_SECRET=replace_with_a_long_random_secret
# 推荐在公网部署时设置；访问者输入后仅保存 HttpOnly 签名 Cookie，不会把密钥暴露给前端脚本。
APP_ACCESS_KEY=replace_with_a_long_random_access_key
# 仅在明确接受公网额度风险时才设为 true；生产环境默认缺少 APP_ACCESS_KEY 即关闭付费接口。
ALLOW_PUBLIC_AI=false
# 非本机/公网研究访问专用；localhost 本地实验会自动跳过。若部署研究版到公网，必须使用高强度随机值。
EXPERIMENT_ADMIN_KEY=replace_with_a_long_random_secret
# 可选：使用工作空间专属的多模态端点
# DASHSCOPE_MULTIMODAL_ENDPOINT=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
